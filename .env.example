# Copy to `.env` and fill in. The justfile injects this file with `uv run --env-file=.env`,
# so GOOGLE_API_KEY reaches pydantic-ai's google provider.

# Required: Gemini API key (used by the default google:gemini-2.5-flash model).
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional overrides (defaults shown).
# AGENT_MODEL=google:gemini-2.5-flash
# HOST=127.0.0.1
# PORT=8000
# Base URL the browser uses to fetch agent-generated images (image output).
# PUBLIC_BASE_URL=http://localhost:8000
# IMAGES_DIR=work_dir/generated_images
